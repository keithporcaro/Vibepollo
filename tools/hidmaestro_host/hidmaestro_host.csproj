<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>VibePollo.HidMaestroHost</RootNamespace>
    <AssemblyName>vibepollo_hidmaestro_host</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Single-file self-contained publish so the sidecar ships as one exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    HIDMaestro.Core is not published to NuGet. Drop HIDMaestro.Core.dll into
    ./external/ before building. When the DLL is present we wire the
    reference AND define HIDMAESTRO_CORE so the ControllerManager compiles
    against the real types. When absent, the sidecar still builds (frames
    are decoded and logged); the host's `is_hidmaestro_available()` check
    is not enough on its own — the user will see no controllers appear
    until the DLL ships next to the exe.
  -->
  <PropertyGroup Condition="Exists('external\HIDMaestro.Core.dll')">
    <DefineConstants>$(DefineConstants);HIDMAESTRO_CORE</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('external\HIDMaestro.Core.dll')">
    <Reference Include="HIDMaestro.Core">
      <HintPath>external\HIDMaestro.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
